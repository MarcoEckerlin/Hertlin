# --- Datenbank ---------------------------------------------------------------
# SQLite-Datei (relativ zu prisma/). In Docker: file:/data/hertlin.db
DATABASE_URL="file:./dev.db"

# --- Domains -----------------------------------------------------------------
# Hauptdomain ohne Protokoll. Kundenportale laufen unter <kuerzel>.<ROOT_DOMAIN>.
# Lokal: localhost:3000  ->  Portale unter http://muster.localhost:3000
# Produktion: hertlin.de ->  Portale unter https://muster.hertlin.de
ROOT_DOMAIN="localhost:3000"
# http nur für die lokale Entwicklung, in Produktion https
APP_PROTOCOL="http"

# --- Sitzungen ---------------------------------------------------------------
# Abmeldung nach so vielen Stunden ohne Aktivität (Standard 72)
# SESSION_IDLE_HOURS="72"

# --- E-Mail (optional) -------------------------------------------------------
# Ohne SMTP_HOST werden Mails nicht verschickt, sondern in storage/mails.log geschrieben.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="Hertlin <support@hertlin.de>"
# Empfänger für Benachrichtigungen über neue Tickets und Anfragen (Standard: support@ aus src/config/site.ts)
# STAFF_NOTIFY_EMAIL="support@hertlin.de"

# --- Dateien -----------------------------------------------------------------
# Ablage für Ticket-Anhänge (Standard: storage/uploads)
# UPLOAD_DIR="/data/uploads"

# --- Übersetzung (optional) --------------------------------------------------
# DeepL (empfohlen, Server in der EU) oder Claude. Ohne Schlüssel ist die Übersetzung ausgeschaltet.
# DEEPL_API_KEY=""
# ANTHROPIC_API_KEY=""
# Anbieter erzwingen: deepl | anthropic | off  (Standard: automatisch nach vorhandenem Schlüssel)
# TRANSLATION_PROVIDER=""
# Modell für Claude (Standard: claude-opus-5-5)
# ANTHROPIC_TRANSLATION_MODEL=""
# Höchstmenge neuer Zeichen pro Tag für den Website-Übersetzer (Standard 500000)
# TRANSLATION_DAILY_LIMIT=""

# --- Telefonanlage (optional) -----------------------------------------------
# Zugangsschlüssel für den Webhook /api/telefonie, z. B. erzeugt mit: openssl rand -hex 32.
# Ohne Wert ist die Anbindung abgeschaltet.
# TELEPHONY_WEBHOOK_TOKEN=""
# Nur diese Absender zulassen (kommagetrennt, IPv4-Netze wie 192.0.2.0/24 möglich)
# TELEPHONY_ALLOWED_IPS=""
# Ländervorwahl für Nummern ohne internationale Vorwahl (Standard 49)
# TELEPHONY_DEFAULT_COUNTRY="49"
