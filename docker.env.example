# Konfiguration für docker compose – kopieren nach docker.env und anpassen.
# Ausführlich: DOCKER.md

# --- Adresse -----------------------------------------------------------------
# Hauptdomain OHNE https://. Kundenportale laufen unter <kuerzel>.<ROOT_DOMAIN>.
#
# Test im Heimnetz ohne eigene Domain (IP des Docker-Servers einsetzen, Port 3000):
ROOT_DOMAIN=192.168.1.50.sslip.io:3000
APP_PROTOCOL=http
#
# Produktion mit eigener Domain und HTTPS (Caddy oder vorhandener Reverse Proxy, siehe DOCKER.md):
# ROOT_DOMAIN=hertlin.de
# APP_PROTOCOL=https

# --- Erster Start ------------------------------------------------------------
# Beispieldaten (Beispielfirmen, Tickets, Demo-Zugänge mit Passwort demo-passwort-2026).
# Für den Test praktisch, in Produktion auf false lassen.
SEED_DEMO_DATA=true
# Legt beim Start einen Administrator an (falls noch nicht vorhanden).
# Den Link zum Passwort-Setzen zeigt: docker compose logs hertlin
ADMIN_EMAIL=
ADMIN_NAME=

# --- E-Mail (optional) -------------------------------------------------------
# Ohne SMTP landen alle Mails (Einladungen, Passwort-Links) in /data/mails.log:
#   docker compose exec hertlin cat /data/mails.log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Hertlin <support@hertlin.de>
# STAFF_NOTIFY_EMAIL=support@hertlin.de

# --- Übersetzung (optional) --------------------------------------------------
# DEEPL_API_KEY=
# ANTHROPIC_API_KEY=

# --- Telefonanlage (optional) ------------------------------------------------
# TELEPHONY_WEBHOOK_TOKEN=
