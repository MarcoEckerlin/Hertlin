# Einstellungen der App für docker compose – kopieren nach docker.env und anpassen.
# Ausführlich: DOCKER.md
#
# Enthält ein Wert ein $-Zeichen (häufig bei Passwörtern), den Wert in einfache Anführungszeichen setzen:
#   SMTP_PASSWORD='ab$cd'
# Änderungen übernehmen: docker compose up -d   (ein Neustart allein liest die Datei nicht neu ein)

# --- Adresse -----------------------------------------------------------------
# Hauptdomain OHNE https://. Kundenportale laufen unter <kuerzel>.<ROOT_DOMAIN>.
#
# Test im Heimnetz ohne eigene Domain (IP des Docker-Servers einsetzen, Port 3000):
ROOT_DOMAIN=192.168.1.50.sslip.io:3000
APP_PROTOCOL=http
#
# Produktion mit eigener Domain und HTTPS (Caddy oder vorhandener Reverse Proxy, siehe DOCKER.md):
# ROOT_DOMAIN=hertlin.de
# APP_PROTOCOL=https

# --- Erster Start ------------------------------------------------------------
# Beispieldaten (Beispielfirmen, Tickets, Demo-Zugänge mit dem öffentlich bekannten Passwort demo-passwort-2026).
# Wirkt nur im Test mit APP_PROTOCOL=http. Mit https werden keine Beispieldaten geladen und
# vorhandene Demo-Zugänge beim Start gesperrt.
SEED_DEMO_DATA=true
# Legt beim Start einen Administrator an (falls noch nicht vorhanden).
# Den Link zum Passwort-Setzen gibt es nur im Protokoll (nicht per E-Mail): docker compose logs hertlin
ADMIN_EMAIL=
ADMIN_NAME=

# --- E-Mail (optional) -------------------------------------------------------
# Ohne SMTP landen alle Mails (Einladungen, Passwort-Links) in /data/mails.log:
#   docker compose exec hertlin cat /data/mails.log
# Versandfehler stehen im Protokoll: docker compose logs hertlin
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Hertlin <support@hertlin.de>
# STAFF_NOTIFY_EMAIL=support@hertlin.de

# --- Übersetzung (optional) --------------------------------------------------
# DEEPL_API_KEY=
# ANTHROPIC_API_KEY=

# --- Telefonanlage (optional) ------------------------------------------------
# TELEPHONY_WEBHOOK_TOKEN=
